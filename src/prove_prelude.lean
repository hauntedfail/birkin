  sm.states.contains sm.initial &&
  sm.terminal.all (fun s => sm.states.contains s) &&
  sm.transitions.all (fun t => sm.states.contains t.src && sm.states.contains t.dst)

def smNoForbiddenBool (sm : StateMachine) : Bool :=
  sm.transitions.all (fun t => !sm.forbidden.contains (t.src, t.dst))

