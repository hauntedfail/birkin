structure Transition where
  src : String
  dst : String
  label : String
  deriving DecidableEq, Repr

structure StateMachine where
  states : List String
  initial : String
  terminal : List String
  transitions : List Transition
  forbidden : List (String × String)
  reversible : List (String × String)
  deriving DecidableEq, Repr

