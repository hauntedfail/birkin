def globMatchAux : Nat → List Char → List Char → Bool
  | 0, _, _ => false
  | _ + 1, [], [] => true
  | _ + 1, [], _ :: _ => false
  | fuel + 1, '*' :: ps, [] => globMatchAux fuel ps []
  | fuel + 1, '*' :: ps, t :: ts =>
    globMatchAux fuel ps (t :: ts) || globMatchAux fuel ('*' :: ps) ts
  | _ + 1, _ :: _, [] => false
  | fuel + 1, '?' :: ps, _ :: ts => globMatchAux fuel ps ts
  | fuel + 1, p :: ps, t :: ts => (p == t) && globMatchAux fuel ps ts

def globMatch (pat text : String) : Bool :=
  let pl := pat.toList
  let tl := text.toList
  globMatchAux (pl.length + tl.length + 1) pl tl

def matchesAnyGlob (pats : List String) (text : String) : Bool :=
  pats.any (fun p => globMatch p text)

structure ScopedImportFact where
  ruleId : String
  rawImport : String
  resolvedPath : Option String
  deriving DecidableEq, Repr

structure ForbiddenRuleFact where
  id : String
  forbidPatterns : List String
  deriving DecidableEq, Repr

def importViolatesRule (r : ForbiddenRuleFact) (imp : ScopedImportFact) : Bool :=
  if r.id != imp.ruleId then false
  else
    matchesAnyGlob r.forbidPatterns imp.rawImport ||
      match imp.resolvedPath with
      | some rp => matchesAnyGlob r.forbidPatterns rp
      | none => false

def forbiddenHit (rules : List ForbiddenRuleFact) (imp : ScopedImportFact) : Bool :=
  rules.any (fun r => importViolatesRule r imp)

def noForbiddenImportsBool (rules : List ForbiddenRuleFact) (imps : List ScopedImportFact) : Bool :=
  imps.all (fun imp => !forbiddenHit rules imp)

theorem noForbiddenImportsBool_sound {rules : List ForbiddenRuleFact} {imps : List ScopedImportFact}
    (h : noForbiddenImportsBool rules imps = true) :
    ∀ imp ∈ imps, forbiddenHit rules imp = false := by
  intro imp himp
  have hb := List.all_eq_true.mp h imp himp
  cases hhit : forbiddenHit rules imp
  · rfl
  · simp [hhit] at hb

